# =====================================================================
# .env de PRODUÇÃO (VPS) — copie para `.env` na raiz e preencha.
#   cp .env.production.example .env
# NUNCA comitar o .env preenchido (já está no .gitignore).
# Usado por docker-compose.prod.yml (Postgres + API).
# =====================================================================

# ---- Postgres (container) ----
POSTGRES_USER=momentos
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
POSTGRES_DB=momentos

# ---- API ----
PORT=3333
NODE_ENV=production

# DATABASE_URL aponta para o SERVIÇO 'postgres' (nome do container na rede compose),
# NÃO 'localhost'. Usuário/senha/db precisam bater com os POSTGRES_* acima.
DATABASE_URL=postgresql://momentos:TROQUE_POR_SENHA_FORTE@postgres:5432/momentos
# false: conexão é interna à rede Docker, sem TLS. (true só se banco externo tipo Supabase/RDS)
DATABASE_SSL=false

# ---- Auth ----
# Gerar: openssl rand -base64 48
JWT_SECRET=TROQUE_gere_com_openssl_rand_base64_48
JWT_EXPIRES_IN=1d
RESET_TOKEN_TTL_MINUTES=30

# ---- URLs públicas (troque pelo seu domínio depois de registrar) ----
FRONTEND_URL=https://SEUDOMINIO.com.br

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=

# ---- E-mail (Brevo API HTTP) ----
BREVO_API_KEY=
MAIL_FROM_EMAIL=contato@SEUDOMINIO.com.br
MAIL_FROM_NAME=Momentos

# ---- Seed admin (opcional) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---- AWS S3 (fotos) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
S3_BUCKET_NAME=momentos-bucket

# ---- Mercado Pago ----
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=
MP_BACK_URL=https://SEUDOMINIO.com.br/assinatura/retorno

# ---- Planos (reais) ----
PLAN_MENSAL_AMOUNT=0.10
PLAN_ANUAL_AMOUNT=0.20
