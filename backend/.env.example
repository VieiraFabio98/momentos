# API
PORT=3333

# Auth
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=1d

# Recuperação de senha
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_TTL_MINUTES=30

# Postgres (docker-compose)
POSTGRES_USER=momentos
POSTGRES_PASSWORD=momentos
POSTGRES_DB=momentos
POSTGRES_PORT=5432

# Backend usa esta URL (TypeORM)
DATABASE_URL=postgresql://momentos:momentos@localhost:5432/momentos?schema=public
# true em produção (Neon/Supabase exigem TLS)
DATABASE_SSL=false

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=

# Envio de email (Brevo API HTTP — deixe vazio p/ usar ConsoleMailProvider em dev)
# API key em app.brevo.com → SMTP & API → API Keys
# Remetente precisa estar verificado em Brevo → Senders
BREVO_API_KEY=
MAIL_FROM_EMAIL=contatomomentos.app@gmail.com
MAIL_FROM_NAME=Momentos

# Seed do admin (npm run seed:admin) — conta que cria eventos sem assinatura
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# AWS S3 (fotos)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
S3_BUCKET_NAME=momentos-bucket

MP_ACCESS_TOKEN=TEST-...        # troca p/ APP_USR- em prod
MP_WEBHOOK_SECRET=...           # valida assinatura x-signature
MP_BACK_URL=${FRONTEND_URL}/assinatura/retorno

# Valores dos planos em reais (default 0.10 / 0.20 se omitido)
PLAN_MENSAL_AMOUNT=0.10
PLAN_ANUAL_AMOUNT=0.20

